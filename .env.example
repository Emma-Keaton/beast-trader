# ── Backend (Render) ──────────────────────────────────
PORT=8787
JWT_SECRET=change-me-to-a-long-random-string
# Optional: Supabase persistence. Leave empty to use local JSON store (backend/data/store.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Watchlist auto-poll cadence (ms). 30000 = 30s, safe for CoinGecko/DexScreener free tiers.
POLL_INTERVAL_MS=30000
# Manual refresh throttle (ms)
REFRESH_THROTTLE_MS=15000
# Paper | live  (live requires per-device API keys saved from Settings)
TRADING_MODE=paper

# ── Real-money execution (three separate locks, all must be open) ──────────
#
# Live trading needs ALL THREE. Each covers a different failure, and none of
# them can substitute for another:
#
#   1. This flag          - "may THIS DEPLOYMENT move money at all".
#                          Set on the server, not in the app. Only the exact
#                          string "true" enables it; "yes"/"1"/"TRUE " fail
#                          closed. Leave it unset everywhere except a machine
#                          you control and can stop.
#   2. Per-device mode    - "has THIS USER consented". Set through Settings,
#                          which shows a confirmation dialog and re-checks
#                          readiness server-side.
#   3. Model promoted     - the scoreboard must show a model that beat the
#                          deflated-Sharpe hurdle on settled live calls. Not a
#                          flag; it is earned.
#
# NETWORK chooses *where* a permitted order executes, not whether it may exist.
# Set NETWORK=testnet to point the same connector at a venue sandbox.
NETWORK=mainnet

# Default venue for live orders when a plan does not name one.
# One of exchange.js SUPPORTED_EXCHANGES: binance | coinbase
EXCHANGE_ID=binance
# Minimum model confidence (0-1) required to auto-open a paper/live position
AUTO_TRADE_MIN_CONFIDENCE=0.65
# Max notional per order in USD
MAX_ORDER_USD=100

# ── Optional API keys (ALL OPTIONAL — the app runs fully keyless) ───────
# A key that is present but wrong degrades to the keyless feed and logs a
# warning; it never breaks the app.
#
# CoinMarketCap. Free Hobby plan: 10,000 calls/month, far more than this app
# uses because every response is cached for minutes.
#   https://coinmarketcap.com/en/professional/  (Account -> API Keys)
CMC_API_KEY=

# Optional higher-tier FX provider. Not required: rates come keylessly from
# open.er-api.com.
FX_API_KEY=

# CoinGecko, only if you add a keyed endpoint later. Unused today.
COINGECKO_API_KEY=

# Helius, for the whale flow collector (backend/src/services/whalewatch.js).
# Optional: without it no wallet flows are collected and everything else works
# unchanged — the collector logs one "disabled" line and stops.
# Free plan: 1,000,000 credits/month. Each 10-minute tick spends ~30 credits
# (10 per enhanced-transaction call x 3 mints) plus a few DexScreener price
# lookups — about 13% of the monthly allowance at the default cadence.
#   https://dashboard.helius.dev
HELIUS_API_KEY=
# Override which mints to watch: SYMBOL:mint,SYMBOL:mint
# (default: SOL, USDC, USDT from backend/src/services/solana.js)
# WHALE_MINTS=
# Collection cadence in ms (default 600000 = 10 minutes)
# WHALE_WATCH_INTERVAL_MS=600000

# ── Frontend (Vercel) ─────────────────────────────────
# VITE_API_URL=<https://your-backend.onrender.com>
# Optional WalletConnect project id for future AppKit swap-in:
# VITE_WALLETCONNECT_PROJECT_ID=

# ── Intraday history collection ───────────────────────────────────────────
# Off by default. Every signal measured so far came from daily bars on large
# caps, which cannot answer questions about long-tail short-timeframe moves. Turn
# this on to start collecting history for the venue the app actually trades.
#
# Note that Render's free tier has an ephemeral filesystem: collected bars are
# lost on redeploy. For history that must survive, point INTRADAY_DIR at durable
# storage or run `npm run collect` on a machine that persists.
COLLECT_INTRADAY=false
COLLECT_INTERVAL=15m
COLLECT_BARS=2000

# ── Persistence (required for real use) ───────────────────────────────────
# Without these the store is backend/data/store.json, which means the paper
# track record RESETS ON EVERY REDEPLOY. The strategic horizon is 14 days, so a
# record that resets hourly is not a record at all.
#
# Run supabase/schema.sql once, then set both values below. It defines all ten
# tables: watchlist, orders, research_logs, device_settings, paper_calls,
# proposals, model_registry, plus the observation tables dex_snapshots,
# whale_flows and whale_profiles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
