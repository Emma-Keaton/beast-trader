# Test-only environment. Forces the local JSON store and the safe defaults.
#
# Without this, tests inherit SUPABASE_* from the shell and write to the REAL
# database - which corrupts the paper track record and makes the suite depend on
# network and on credentials being valid. A test must never touch production data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
NETWORK=testnet
